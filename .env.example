# Copy to .env.development (or .env.local) and fill in real values for your environment.
# See src/auth/oidcConfig.ts's REQUIRED_ENV_VARS -- these three are checked at app startup and
# render a clear configuration-error screen if any is missing/blank (deferred-work.md, spec-1-2a).

# Keycloak realm issuer URL (Authorization Code + PKCE, AD-4). Local default points at the
# docker-compose Keycloak on port 8180 (or 8280 if you've remapped it locally).
VITE_KEYCLOAK_ISSUER=http://localhost:8180/realms/boardmember

# The public SPA client registered in that realm (see docker/keycloak/realm-boardmember.json).
VITE_KEYCLOAK_CLIENT_ID=boardmember-spa

# Base URL of the Spring Boot backend API this SPA calls.
VITE_API_BASE_URL=http://localhost:8080
